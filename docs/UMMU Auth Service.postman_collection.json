    {
      "name": "OAuth Client Credentials",
      "description": "Service principal tokens carry client_id, audience, OAuth scope, and optional access contexts; no user roles or permissions.",
      "item": [
        {
          "name": "Request service access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "grant_type", "value": "client_credentials", "type": "text"},
                {"key": "client_id", "value": "{{oauth_client_id}}", "type": "text"},
                {"key": "client_secret", "value": "{{client_secret}}", "type": "text"},
                {"key": "audience", "value": "{{resource_audience}}", "type": "text"},
                {"key": "scope", "value": "student:read", "type": "text"}
              ]
            },
            "url": "{{baseUrl}}/api/v1/oauth/token",
            "description": "Uses a confidential client registered with the client_credentials grant, allowed audience, and requested scope."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client Credentials grant succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Response follows OAuth token shape', function () {",
                  "    pm.expect(body.access_token).to.be.a('string');",
                  "    pm.expect(body.token_type).to.eql('Bearer');",
                  "    pm.expect(body.scope).to.eql('student:read');",
                  "    pm.expect(body.refresh_token).to.be.undefined;",
                  "});",
                  "if (body.access_token) pm.collectionVariables.set('service_access_token', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject ungranted client scope",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "grant_type", "value": "client_credentials", "type": "text"},
                {"key": "client_id", "value": "{{oauth_client_id}}", "type": "text"},
                {"key": "client_secret", "value": "{{client_secret}}", "type": "text"},
                {"key": "audience", "value": "{{resource_audience}}", "type": "text"},
                {"key": "scope", "value": "student:delete", "type": "text"}
              ]
            },
            "url": "{{baseUrl}}/api/v1/oauth/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client cannot request an ungranted scope', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
