{
  "info": {
    "_postman_id": "3e75b96b-4376-4b6f-9f4f-4b69a2609001",
    "name": "UMMU Auth Service",
    "description": "Auth Service API and Google OpenID Connect flow. See google-oidc-postman.md for setup and browser/Postman cookie instructions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9001"
    },
    {
      "key": "username",
      "value": "alice"
    },
    {
      "key": "password",
      "value": "ChangeMe123!"
    },
    {
      "key": "email",
      "value": "alice@example.com"
    },
    {
      "key": "full_name",
      "value": "Alice Example"
    },
    {
      "key": "google_state",
      "value": ""
    },
    {
      "key": "google_code",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Google OIDC",
      "item": [
        {
          "name": "1 - Start login",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/google",
            "description": "Start the browser login. Keep Postman's cookie jar enabled, then open the Location response header in a browser. Follow the documented procedure to complete the callback in Postman."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Google login redirects to the authorization provider', function () {",
                  "    pm.response.to.have.status(302);",
                  "});",
                  "const location = pm.response.headers.get('Location');",
                  "if (location) {",
                  "    const authorizationUrl = require('url').parse(location, true);",
                  "    const state = authorizationUrl.query.state;",
                  "    if (state) pm.collectionVariables.set('google_state', state);",
                  "    pm.test('Authorization request includes OIDC scopes', function () {",
                  "        const scopes = (authorizationUrl.query.scope || '').split(' ');",
                  "        pm.expect(scopes).to.include('openid');",
                  "        pm.expect(scopes).to.include('email');",
                  "        pm.expect(scopes).to.include('profile');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "2 - Complete callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/google/callback?code={{google_code}}&state={{google_state}}",
            "description": "After completing consent in the browser, copy the callback code and state from its address bar into the collection variables, then send this request. The Postman cookie jar must contain the state cookie from request 1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Google callback succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Response contains access and refresh tokens', function () {",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.data.refresh_token).to.be.a('string').and.not.empty;",
                  "});",
                  "if (body.data && body.data.access_token && body.data.refresh_token) {",
                  "    pm.collectionVariables.set('access_token', body.data.access_token);",
                  "    pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"{{full_name}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.access_token && body.data.refresh_token) {",
                  "    pm.collectionVariables.set('access_token', body.data.access_token);",
                  "    pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.access_token && body.data.refresh_token) {",
                  "    pm.collectionVariables.set('access_token', body.data.access_token);",
                  "    pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Revokes refresh-token state for the authenticated user."
          }
        }
      ]
    }
  ]
}
