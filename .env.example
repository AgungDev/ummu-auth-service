# APPLICATION
APP_NAME=UMMU Auth Service
APP_ENV=development
APP_PORT=9001
APP_VERSION=1.0.0

# DATABASE
DB_HOST=db
DB_PORT=54321
DB_USER=root
DB_PASSWORD=admin
DB_NAME=auth_service
DB_SSLMODE=disable
DB_DRIVER=postgres

# JWT KEYS
JWT_PRIVATE_KEY_PATH=/app/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/jwt_public.pem
JWT_ISSUER=https://auth.ummu.ac.id
JWT_KEY_ID=ummu-auth-2026-01
JWT_ALLOWED_AUDIENCES=siak-legacy-api

# GOOGLE OPENID CONNECT
# Configure the OAuth consent screen application name as "UMMU Auth Service".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:7000/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:5173/oauth/callback
