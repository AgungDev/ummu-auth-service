# APPLICATION
APP_NAME=UMMU Auth Service
APP_ENV=development
APP_PORT=9001
APP_VERSION=1.0.0

# DATABASE
DB_HOST=db
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=auth_service
DB_SSLMODE=disable
DB_DRIVER=postgres

# JWT KEYS
JWT_PRIVATE_KEY_PATH=/app/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/jwt_public.pem

# GOOGLE OPENID CONNECT
# Configure the OAuth consent screen application name as "UMMU Auth Service".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:9001/auth/google/callback
